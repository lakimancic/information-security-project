{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 80,
	"plugins": [
		"prettier-plugin-svelte",
		"prettier-plugin-classnames",
		"prettier-plugin-multiline-arrays",
		"prettier-plugin-tailwindcss"
	],
	"overrides": [
		{
			"files": ["**/*.svelte"],
			"options": {
				"parser": "svelte",
				"customAttributes": ["class"],
				"endingPosition": "absolute"
			}
		}
	],
	"svelteStrictMode": true
}
